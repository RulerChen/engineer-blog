    "format:fix": "oxfmt .",
    "fetch-icons": "tsx scripts/fetchIcons.ts"
  },
  "dependencies": {
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vue-tsc": "^3.3.7"
  },
  "overrides": {
    "vue-tsc": {
      "typescript": "^6.0.3"
    }
  },
  "engines": {
    "node": ">=22"
  }
