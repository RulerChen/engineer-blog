{
  "name": "engineer-blog",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build-data": "tsx scripts/fetchIcons.ts && tsx scripts/buildEntries.ts",
    "predev": "tsx scripts/fetchIcons.ts && tsx scripts/buildEntries.ts",
    "prebuild": "tsx scripts/fetchIcons.ts && tsx scripts/buildEntries.ts",
    "typecheck": "vue-tsc --noEmit",
    "lint": "oxlint .",
