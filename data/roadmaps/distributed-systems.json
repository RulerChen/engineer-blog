{
  "id": "distributed-systems",
  "title": "Distributed systems",
  "blurb": "Consensus, consistency and transactions across many machines, how they fail in production, and how later systems redesigned the classics.",
  "before": ["operating-systems", "networking"],
  "next": ["data-systems", "ml-systems"],
  "parts": [
    {
      "name": "Foundations",
      "steps": [
        {
          "main": {
            "type": "course",
            "title": "MIT 6.5840: Distributed Systems",
            "url": "https://pdos.csail.mit.edu/6.824/",
            "source": "MIT",
            "year": "2026",
            "why": "Papers from MapReduce to PBFT, and labs that build MapReduce, Raft and a sharded key-value store on it. In English."
          },
          "alternative": [
            {
              "type": "course",
              "title": "Distributed Systems lecture series",
              "url": "https://www.youtube.com/playlist?list=PLeKd45zvjcDFUEv_ohr_HdUFe97RItdiB",
              "source": "University of Cambridge",
              "year": "2020"
            },
            {
              "type": "course",
              "title": "MIT 6.824 Distributed Systems (Spring 2020)",
              "url": "https://www.youtube.com/playlist?list=PLrw6a1wE39_tb2fErI4-WkMbsvGQk9_UB",
              "source": "MIT",
              "year": "2020"
            }
          ]
        }
      ]
    },
    {
      "name": "Consensus",
      "steps": [
        {
          "main": {
            "url": "https://lamport.azurewebsites.net/pubs/time-clocks.pdf",
            "why": "Lamport clocks. Order events across machines without a shared clock."
          }
        },
        {
          "main": {
            "type": "paper",
            "title": "The Part-Time Parliament",
            "url": "https://lamport.azurewebsites.net/pubs/lamport-paxos.pdf",
            "source": "DEC",
            "year": "1998",
            "why": "Paxos. The original paper, told as a Greek parliament."
          },
          "background": [
            {
              "url": "https://lamport.azurewebsites.net/pubs/paxos-simple.pdf"
            }
          ],
          "further": [
            {
              "type": "paper",
              "title": "Impossibility of Distributed Consensus with One Faulty Process",
              "url": "https://groups.csail.mit.edu/tds/papers/Lynch/jacm85.pdf",
              "source": "Yale",
              "year": "1985"
            },
            {
              "type": "paper",
              "title": "Paxos vs Raft: Have we reached consensus on distributed consensus?",
              "url": "https://arxiv.org/pdf/2004.05074",
              "source": "University of Cambridge",
              "year": "2020"
            }
          ]
        },
        {
          "main": {
            "url": "https://raft.github.io/raft.pdf",
            "why": "Consensus like Paxos, split into leader election and log replication so it is easier to build."
          },
          "further": [
            {
              "type": "paper",
              "title": "Viewstamped Replication Revisited",
              "url": "https://dspace.mit.edu/handle/1721.1/71763",
              "source": "MIT",
              "year": "2012"
            },
            {
              "type": "paper",
              "title": "Vive La Différence: Paxos vs. Viewstamped Replication vs. Zab",
              "url": "https://arxiv.org/pdf/1309.5671",
              "source": "Cornell",
              "year": "2013"
            }
          ]
        },
        {
          "main": {
            "url": "https://research.google.com/archive/paxos_made_live.pdf",
            "why": "What it took to turn Paxos into a real system for Chubby."
          },
          "further": [
            {
              "url": "https://engineering.fb.com/2023/05/16/data-infrastructure/mysql-raft-meta/"
            }
          ]
        }
      ]
    },
    {
      "name": "Coordination",
      "steps": [
        {
          "main": {
            "url": "https://research.google.com/archive/chubby-osdi06.pdf",
            "why": "Google's lock service, which GFS and Bigtable use to elect their masters."
          }
        },
        {
          "main": {
            "url": "https://www.usenix.org/legacy/event/atc10/tech/full_papers/Hunt.pdf",
            "why": "A small tree of files with watches, used to build locks and leader election."
          }
        },
        {
          "main": {
            "url": "https://blog.cloudflare.com/a-byzantine-failure-in-the-real-world/",
            "why": "A half-broken switch kept etcd re-electing leaders and hurt the API for over six hours."
          }
        },
        {
          "main": {
            "url": "https://www.linkedin.com/blog/engineering/infrastructure/scalable-multi-language-service-discovery-at-linkedin",
            "why": "Service discovery moved off ZooKeeper, cutting update delay from 30 s to 5 s."
          }
        }
      ]
    },
    {
      "name": "Replication and consistency",
      "steps": [
        {
          "main": {
            "url": "https://research.google.com/archive/gfs-sosp2003.pdf",
            "why": "One master for metadata and replicated chunks for data, built for constant failures."
          },
          "further": [
            {
              "url": "https://pages.cs.wisc.edu/~akella/CS838/F15/838-CloudPapers/hdfs.pdf"
            }
          ]
        },
        {
          "main": {
            "type": "paper",
            "title": "Linearizability: A Correctness Condition for Concurrent Objects",
            "url": "https://cs.brown.edu/people/mph/HerlihyW90/p463-herlihy.pdf",
            "source": "CMU",
            "year": "1990",
            "why": "Each operation seems to happen instantly, between its call and its return."
          }
        },
        {
          "main": {
            "type": "paper",
            "title": "Chain Replication for Supporting High Throughput and Availability",
            "url": "https://www.usenix.org/legacy/event/osdi04/tech/full_papers/renesse/renesse.pdf",
            "source": "Cornell",
            "year": "2004",
            "why": "Writes go in at the head and reads come from the tail."
          },
          "further": [
            {
              "url": "https://engineering.fb.com/2022/05/04/data-infrastructure/delta/"
            }
          ]
        },
        {
          "main": {
            "type": "paper",
            "title": "Brewer's Conjecture and the Feasibility of Consistent, Available, Partition-Tolerant Web Services",
            "url": "https://groups.csail.mit.edu/tds/papers/Gilbert/Brewer6.pdf",
            "source": "MIT",
            "year": "2002",
            "why": "CAP theorem. During a network partition, a system cannot be both consistent and available."
          }
        },
        {
          "main": {
            "url": "https://www.allthingsdistributed.com/files/amazon-dynamo-sosp2007.pdf",
            "why": "Always accepts writes and resolves conflicts on read."
          },
          "further": [
            {
              "url": "https://research.google.com/archive/bigtable-osdi06.pdf"
            },
            {
              "url": "https://www.cs.cornell.edu/projects/ladis2009/papers/lakshman-ladis2009.pdf"
            }
          ]
        },
        {
          "main": {
            "url": "https://cdn.amazon.science/dc/2b/4ef2b89649f9a393d37d3e042f4e/amazon-aurora-design-considerations-for-high-throughput-cloud-native-relational-databases.pdf",
            "why": "Only the redo log goes over the network, and storage builds the pages."
          }
        },
        {
          "main": {
            "type": "paper",
            "title": "Scaling Memcache at Facebook",
            "url": "https://www.usenix.org/system/files/conference/nsdi13/nsdi13-final170_update.pdf",
            "source": "Meta",
            "year": "2013",
            "why": "Leases and invalidations let memcached serve billions of requests per second."
          },
          "further": [
            {
              "url": "https://engineering.fb.com/2022/06/08/core-infra/cache-made-consistent/"
            }
          ]
        }
      ]
    },
    {
      "name": "Transactions",
      "steps": [
        {
          "main": {
            "url": "https://www.usenix.org/system/files/conference/osdi12/osdi12-final-16.pdf",
            "why": "TrueTime bounds clock error, so transactions stay consistent across data centers."
          }
        },
        {
          "main": {
            "type": "paper",
            "title": "Life beyond Distributed Transactions: an Apostate's Opinion",
            "url": "https://www.cidrdb.org/cidr2007/papers/cidr07p15.pdf",
            "source": "Amazon",
            "year": "2007",
            "why": "Big systems skip distributed transactions, updating one entity at a time and messaging the rest."
          },
          "further": [
            {
              "url": "https://medium.com/airbnb-engineering/avoiding-double-payments-in-a-distributed-payments-system-2981f6b070bb"
            }
          ]
        },
        {
          "main": {
            "url": "https://dropbox.tech/infrastructure/cross-shard-transactions-at-10-million-requests-per-second",
            "why": "Two-phase commit across MySQL shards at 10 million requests per second."
          }
        }
      ]
    },
    {
      "name": "Failures",
      "steps": [
        {
          "main": {
            "type": "paper",
            "title": "The Tail at Scale",
            "url": "https://www.barroso.org/publications/TheTailAtScale.pdf",
            "source": "Google",
            "year": "2013",
            "why": "With wide fan-out, a few slow servers slow most requests, and hedged requests help."
          }
        },
        {
          "main": {
            "type": "article",
            "title": "Timeouts, retries, and backoff with jitter",
            "url": "https://aws.amazon.com/builders-library/timeouts-retries-and-backoff-with-jitter/",
            "source": "Amazon",
            "year": "2019",
            "why": "Retries at every layer multiply load, so use backoff with jitter and a retry budget."
          }
        }
      ]
    },
    {
      "name": "Byzantine faults",
      "steps": [
        {
          "main": {
            "type": "paper",
            "title": "Practical Byzantine Fault Tolerance",
            "url": "https://pdos.csail.mit.edu/6.824/papers/castro-practicalbft.pdf",
            "source": "MIT",
            "year": "1999",
            "why": "Consensus that survives lying replicas, as long as fewer than a third are faulty."
          }
        },
        {
          "main": {
            "type": "paper",
            "title": "Bitcoin: A Peer-to-Peer Electronic Cash System",
            "url": "https://bitcoin.org/bitcoin.pdf",
            "year": "2008",
            "why": "Proof of work lets strangers agree on one transaction history."
          }
        }
      ]
    },
    {
      "name": "Redesigns",
      "steps": [
        {
          "main": {
            "url": "https://www.usenix.org/system/files/atc22-elhemali.pdf",
            "why": "Shares Dynamo's name but runs each partition as a Multi-Paxos group."
          }
        },
        {
          "main": {
            "type": "article",
            "title": "Diving Deep on S3 Consistency",
            "url": "https://www.allthingsdistributed.com/2021/04/s3-strong-consistency.html",
            "source": "Amazon",
            "year": "2021",
            "why": "How S3 became strongly consistent, checked with proofs and model checking."
          }
        },
        {
          "main": {
            "url": "https://www.cockroachlabs.com/pdf/cockroachdb-the-resilient-geo-distributed-sql-database-sigmod-2020.pdf",
            "why": "Spanner-style transactions with hybrid logical clocks instead of special clock hardware."
          }
        },
        {
          "main": {
            "url": "https://aws.amazon.com/blogs/containers/under-the-hood-amazon-eks-ultra-scale-clusters/",
            "why": "EKS replaced etcd's Raft with an internal AWS journal to reach 100,000-node clusters."
          }
        }
      ]
    }
  ]
}
