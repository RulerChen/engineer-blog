{
  "id": "deep-learning",
  "title": "Deep learning",
  "blurb": "How deep networks are trained, the architectures that made them work, generative models, and where they replaced classic ML in production.",
  "before": ["machine-learning"],
  "next": ["ml-systems", "computer-vision", "nlp"],
  "parts": [
    {
      "name": "Foundations",
      "steps": [
        {
          "main": {
            "type": "course",
            "title": "Machine Learning 2021",
            "url": "https://www.youtube.com/playlist?list=PLJV_el3uVTsMhtt7_Y6sgTHGHp1Vb2P2J",
            "source": "NTU",
            "year": "2021",
            "why": "Training tricks, CNN, self-attention, Transformer and GAN. In Mandarin."
          },
          "alternative": [
            {
              "type": "course",
              "title": "CMU 11-785: Introduction to Deep Learning",
              "url": "https://deeplearning.cs.cmu.edu/S25/index.html",
              "source": "CMU",
              "year": "2025"
            }
          ]
        },
        {
          "main": {
            "type": "paper",
            "title": "Learning Representations by Back-propagating Errors",
            "url": "https://www.cs.utoronto.ca/~hinton/absps/naturebp.pdf",
            "source": "UC San Diego",
            "year": "1986",
            "why": "Hidden layers learn their own features."
          }
        }
      ]
    },
    {
      "name": "Training",
      "steps": [
        {
          "main": {
            "type": "paper",
            "title": "Understanding the Difficulty of Training Deep Feedforward Neural Networks",
            "url": "https://proceedings.mlr.press/v9/glorot10a/glorot10a.pdf",
            "source": "University of Montreal",
            "year": "2010",
            "why": "Xavier initialization. Keeps gradients from vanishing in deep nets."
          },
          "further": [
            {
              "type": "paper",
              "title": "Delving Deep into Rectifiers: Surpassing Human-Level Performance on ImageNet Classification",
              "url": "https://arxiv.org/abs/1502.01852",
              "source": "Microsoft",
              "year": "2015"
            }
          ]
        },
        {
          "main": {
            "type": "paper",
            "title": "Dropout: A Simple Way to Prevent Neural Networks from Overfitting",
            "url": "https://jmlr.org/papers/volume15/srivastava14a/srivastava14a.pdf",
            "source": "University of Toronto",
            "year": "2014",
            "why": "Randomly drop units in training to curb overfitting."
          }
        },
        {
          "main": {
            "type": "paper",
            "title": "Adam: A Method for Stochastic Optimization",
            "url": "https://arxiv.org/abs/1412.6980",
            "source": "University of Amsterdam",
            "year": "2014",
            "why": "Per-parameter learning rates, still the default optimizer."
          },
          "further": [
            {
              "type": "paper",
              "title": "Decoupled Weight Decay Regularization",
              "url": "https://arxiv.org/abs/1711.05101",
              "source": "University of Freiburg",
              "year": "2017"
            }
          ]
        },
        {
          "main": {
            "type": "paper",
            "title": "Batch Normalization: Accelerating Deep Network Training by Reducing Internal Covariate Shift",
            "url": "https://arxiv.org/abs/1502.03167",
            "source": "Google",
            "year": "2015",
            "why": "Normalize layer inputs to train much faster."
          },
          "further": [
            {
              "type": "paper",
              "title": "Layer Normalization",
              "url": "https://arxiv.org/abs/1607.06450",
              "source": "University of Toronto",
              "year": "2016"
            }
          ]
        },
        {
          "main": {
            "type": "paper",
            "title": "Understanding Deep Learning Requires Rethinking Generalization",
            "url": "https://arxiv.org/abs/1611.03530",
            "source": "Google",
            "year": "2016",
            "why": "Nets fit random labels, so classic theory cannot explain why they generalize."
          },
          "further": [
            {
              "type": "paper",
              "title": "Deep Double Descent: Where Bigger Models and More Data Hurt",
              "url": "https://arxiv.org/abs/1912.02292",
              "source": "OpenAI",
              "year": "2019"
            }
          ]
        }
      ]
    },
    {
      "name": "Convolutional networks",
      "steps": [
        {
          "main": {
            "type": "paper",
            "title": "Gradient-Based Learning Applied to Document Recognition",
            "url": "http://yann.lecun.com/exdb/publis/pdf/lecun-01a.pdf",
            "source": "AT&T Labs",
            "year": "1998",
            "why": "LeNet-5. Convolution and pooling, trained end to end."
          }
        },
        {
          "main": {
            "type": "paper",
            "title": "ImageNet Classification with Deep Convolutional Neural Networks",
            "url": "https://proceedings.neurips.cc/paper_files/paper/2012/file/c399862d3b9d6b76c8436e924a68c45b-Paper.pdf",
            "source": "University of Toronto",
            "year": "2012",
            "why": "AlexNet. A GPU-trained CNN won ImageNet 2012 and started the boom."
          }
        },
        {
          "main": {
            "type": "paper",
            "title": "Very Deep Convolutional Networks for Large-Scale Image Recognition",
            "url": "https://arxiv.org/abs/1409.1556",
            "source": "University of Oxford",
            "year": "2014",
            "why": "VGG. Deep stacks of 3x3 convolutions show depth alone buys accuracy."
          },
          "further": [
            {
              "type": "paper",
              "title": "Going Deeper with Convolutions",
              "url": "https://arxiv.org/abs/1409.4842",
              "source": "Google",
              "year": "2014"
            }
          ]
        },
        {
          "main": {
            "type": "paper",
            "title": "Deep Residual Learning for Image Recognition",
            "url": "https://arxiv.org/abs/1512.03385",
            "source": "Microsoft",
            "year": "2015",
            "why": "ResNet. Skip connections make 100+ layer networks trainable."
          }
        }
      ]
    },
    {
      "name": "Sequence models",
      "steps": [
        {
          "main": {
            "type": "paper",
            "title": "Long Short-Term Memory",
            "url": "https://www.bioinf.jku.at/publications/older/2604.pdf",
            "source": "TU Munich",
            "year": "1997",
            "why": "Gates keep the error signal alive over long sequences."
          }
        },
        {
          "main": {
            "url": "https://arxiv.org/abs/1706.03762",
            "why": "Transformer. Self-attention replaces recurrence and trains in parallel."
          }
        }
      ]
    },
    {
      "name": "Generative models",
      "steps": [
        {
          "main": {
            "type": "paper",
            "title": "Auto-Encoding Variational Bayes",
            "url": "https://arxiv.org/abs/1312.6114",
            "source": "University of Amsterdam",
            "year": "2013",
            "why": "VAE. The reparameterization trick makes latent models trainable by gradients."
          }
        },
        {
          "main": {
            "type": "paper",
            "title": "Generative Adversarial Networks",
            "url": "https://arxiv.org/abs/1406.2661",
            "source": "University of Montreal",
            "year": "2014",
            "why": "A generator learns by fooling a discriminator."
          }
        },
        {
          "main": {
            "type": "paper",
            "title": "Denoising Diffusion Probabilistic Models",
            "url": "https://arxiv.org/abs/2006.11239",
            "source": "UC Berkeley",
            "year": "2020",
            "why": "Generate images by removing noise step by step."
          }
        }
      ]
    },
    {
      "name": "Evolution",
      "steps": [
        {
          "main": {
            "type": "paper",
            "title": "Applying Deep Learning to Airbnb Search",
            "url": "https://arxiv.org/abs/1810.09591",
            "source": "Airbnb",
            "year": "2018",
            "why": "Search ranking moves from gradient boosted trees to neural networks."
          }
        },
        {
          "main": {
            "url": "https://www.linkedin.com/blog/engineering/feed/homepage-feed-multi-task-learning-using-tensorflow",
            "why": "One logistic regression per objective becomes one multi-task network."
          }
        },
        {
          "main": {
            "url": "https://www.uber.com/blog/deepeta-how-uber-predicts-arrival-times/",
            "why": "XGBoost gives way to a linear transformer for ETA prediction."
          }
        },
        {
          "main": {
            "url": "https://shopify.engineering/evolution-product-classification",
            "why": "TF-IDF with logistic regression, then image and text models, then a VLM."
          },
          "further": [
            {
              "url": "https://shopify.engineering/using-rich-image-text-data-categorize-products"
            }
          ]
        }
      ]
    }
  ]
}
